{
  "schemaVersion": 1,
  "id": "encore_music",
  "version": "${version}",
  "name": "Encore Music",
  "description": "Control Spotify playback and view the currently playing track inside Minecraft using the Spotify Developer API.",
  "authors": [
    "Noah Brooks"
  ],
  "contact": {
    "homepage": "https://github.com/theswag1/encore-music",
    "sources": "https://github.com/theswag1/encore-music",
    "issues": "https://github.com/theswag1/encore-music/issues"
  },
  "license": "MIT",
  "icon": "assets/encore_music/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.noah.spotifycontroller.fabric.SpotifyControllerFabricClient"
    ]
  },
  "depends": {
    "fabricloader": "${fabric_loader_range}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
